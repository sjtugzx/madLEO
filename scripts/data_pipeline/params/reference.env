# MAD-LEO reference subset pipeline parameters.
# Credentials come from the git-ignored .env (sourced by run_reference.sh);
# never put credentials in this file.
SUBSET=reference
REFERENCE_TARGETS="sentinel-3a sentinel-3b jason-3 sentinel-6a cryosat-2 saral jason-1 jason-2 topex-poseidon hy-2a swot"
TABLES_DIR=results/tables
# DRY_RUN=1 only prints the step plan; set DRY_RUN=0 in your shell to execute.
DRY_RUN="${DRY_RUN:-1}"
# Python HTTP clients must bypass any local system proxy.
NO_PROXY=*
no_proxy=*
