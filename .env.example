# MAD-LEO pipeline credentials and private endpoints.
# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Space-Track (authenticated fallback for TLE / GP history)
SPACETRACK_ID=
SPACETRACK_PASSWORD=

# Copernicus Data Space Ecosystem (Sentinel-3 AUX_POEORB orbit products)
CDSE_USERNAME=
CDSE_PASSWORD=

# NASA Earthdata (CDDIS DORIS/ILRS archives, PO.DAAC Jason-3 OGDR)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# CDDIS anonymous FTPS identification email (fallback download route)
CDDIS_FTPS_EMAIL=

# Optional: yearly Starlink TLE archive share (private link; the pipeline
# prefers this non-interactive archive over interactive API traffic).
STARLINK_TLE_ARCHIVE_URL=
